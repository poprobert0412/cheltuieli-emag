{
  "name": "cheltuieli-emag-extensie",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "paritate:genereaza": "node scripts/ruleaza_python.mjs",
    "tabele:unicode": "node scripts/scrie_tabele_unicode.mjs",
    "build": "node scripts/build.mjs",
    "build:strict": "node scripts/build.mjs --strict",
    "iconite": "node scripts/iconite.mjs",
    "test:unit": "node --test \"tests/unit/**/*.test.js\"",
    "test:paritate": "npm run paritate:genereaza && node --test \"tests/paritate/**/*.test.js\"",
    "test:e2e": "npm run build:strict && node --test --test-concurrency=1 \"tests/e2e/**/*.test.js\"",
    "verify": "npm run test:unit && npm run test:paritate && npm run build:strict && npm run test:e2e"
  },
  "devDependencies": {
    "fake-indexeddb": "6.2.6",
    "playwright-core": "1.63.0"
  }
}
